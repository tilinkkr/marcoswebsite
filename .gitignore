# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tmp/
/backend/.venv/
/backend/.pytest_cache/
/backend/.ruff_cache/
/backend/*.db
/backend/load-test-results*.csv
**/__pycache__/
/scripts/source-assets/

# Local source PNGs retained only for asset regeneration; runtime uses WebP.
/public/images/marcos/vision/*.png
/public/images/marcos/how-it-works/*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/debug.log

# env files (only the placeholder template is safe to commit)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI link and runtime metadata
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
