# Public Supabase project settings. The anon key is safe for browser use when RLS is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends this as Authorization: Bearer <secret> to scheduled routes.
CRON_SECRET=

# Random server-only salt used to pseudonymize IP addresses in application audit logs.
AUDIT_IP_HASH_SALT=

# Exactly three comma-separated emails. Create/invite these users in Supabase Auth.
MARCOS_ADMIN_LOGIN_DOMAIN=admin.markos.in
MARCOS_ADMIN_EMAILS=admin1@admin.markos.in,admin2@admin.markos.in,admin3@admin.markos.in

# Upstash REST credentials. Keep both values server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSNs are identifiers, not secrets. Use the public value for browser telemetry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog browser analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Future Stripe integration. Keep secret/webhook values server-side.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Future Razorpay integration. Keep secret/webhook values server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public business contact used only to build WhatsApp deep-links.
NEXT_PUBLIC_MARCOS_WHATSAPP_NUMBER=919187587488

# Public deployment origin used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Manual payment asset supplied by MARCOS. Do not generate banking details.
PAYMENT_QR_ASSET=/images/payments/marcos-upi-qr.webp

# Shared business configuration mirrored by the backend.
RISK_POLICY_VERSION=2026-09-v1
APP_BASE_URL=http://localhost:3000

# Public contact details. Empty values are hidden from the Contact page.
MARCOS_EMAIL=
MARCOS_WHATSAPP_NUMBER=+91 91875 87488
MARCOS_INSTAGRAM_URL=
MARCOS_YOUTUBE_URL=
MARCOS_DISCORD_URL=
MARCOS_X_URL=
